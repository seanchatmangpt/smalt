# The directory Mix will write compiled artifacts to (including multi-lane builds)
/_build/
/_build-*/
/_build_*

# Compiled BEAM bytecode
*.beam

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
smalt-*.tar

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Local secrets & local dev certificates
.env
.env.*
!.env.example
.smalt/

# Elixir language server
.elixir_ls/

# Python bytecode, caches & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Rust / Cargo build artifacts
target/
cli/target/

# Local agent & tooling runtime state
.claude/
.clap-noun-verb/

# Logs & ephemeral test runs
*.log
/substrate.log
.logs/
.work/

# SDK smoke tier
test/sdk-smoke/.deps/
test/sdk-smoke/.logs/

# Terraform fixture
test/terraform_fixture/.terraform*/
*.tfstate*
*.tfstate.backup
*.tfplan

# Node / JS dependencies
node_modules/
test/sdk-full/node_modules/


# Workspace bench artifacts (heapsnapshots etc.)
workspace/.bench/
workspace/bench_results/

# Mutation-probe leftovers (sed/python probe scratch)
*.mut
.venv*/

# trust shim build artifact (source is committed)
scripts/trust_shim/*.dylib

# scratch (anneal sweep output)
/anneal.txt
.anneal.txt.swp
/var/

# docker/burn matrix results (generated by parallel-matrix.sh)
docker/burn/results/

# burn run artifacts (receipts dir is tracked; raw run logs are not)
docs/jira/v26.10.18/burn/*.log

# azsim/burn ephemeral run artifacts (receipts + JSONL are tracked)
test/azsim/tmp/
docker/burn/tmp/
tmp/burn-*.jsonl
tmp/burn-flood-status-*
tmp/burn-leg-*.log
tmp/kill-storm/
tmp/azb19/
tmp/azb20/

tmp/have/

# npm-from-root byproduct (sdk probes resolve via test/sdk-smoke/node_modules; nothing committed uses root)
/package.json
/package-lock.json

# npm-from-root byproduct (explicit anchor; node_modules/ above already matches)
/node_modules/

# v26.10.19: tf fixture moved to scripts/tf_fixtures (test/terraform_fixture deleted 64f6099)
scripts/tf_fixtures/.terraform*/
