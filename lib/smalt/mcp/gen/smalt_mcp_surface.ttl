    ema:capabilityId "kv.deletedkeys.list" ;
    ema:capabilityName "Key Vault deleted keys list" ;
    ema:capabilityDescription "Soft-deleted vault key bundles (recoveryId, deletedDate, scheduledPurgeDate) from the deleted-keys table." ;
    ema:observationScope "read_only" ; ema:mutationScope "none" ;
