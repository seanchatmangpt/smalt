[] a ema:Capability ; ema:capabilityOf [] ;
    ema:capabilityId "lro.operations.list" ;
    ema:capabilityName "Long-running operations list" ;
    ema:capabilityDescription "In-flight and terminal LRO operation records from the operations store, optional subscription filter." ;
    ema:observationScope "read_only" ; ema:mutationScope "none" ;
    ema:requiresAuthority false ; ema:isReversible true ;
    ema:receiptSemantics "logged" ; ema:capabilityOrder 12 ;
