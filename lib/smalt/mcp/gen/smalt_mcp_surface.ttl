[] a ema:Capability ; ema:capabilityOf [] ;
    ema:capabilityId "health.readiness" ;
    ema:capabilityName "Health readiness" ;
    ema:capabilityDescription "Structural readiness verdict with scheduler/store/memory/cluster checks (degrades on structure, never load)." ;
    ema:observationScope "read_only" ; ema:mutationScope "none" ;
