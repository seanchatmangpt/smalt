[] a ema:Capability ; ema:capabilityOf [] ;
    ema:capabilityId "cluster.status" ;
    ema:capabilityName "Cluster status" ;
    ema:capabilityDescription "Cluster poller status: enabled, joined nodes, dns name/port, exhausted addresses." ;
    ema:observationScope "read_only" ; ema:mutationScope "none" ;
    ema:requiresAuthority false ; ema:isReversible true ;
    ema:receiptSemantics "logged" ; ema:capabilityOrder 13 ;
