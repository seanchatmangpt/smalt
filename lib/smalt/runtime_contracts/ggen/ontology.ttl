@prefix rtc: <https://smalt.local/ontology/runtime-contracts#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://smalt.local/runtime-contracts/arm-envelope> a rtc:Contract ;
  rtc:id "arm_envelope" ;
  rtc:module "Smalt.RuntimeContracts.ArmEnvelope" ;
  rtc:plane "control_plane" ;
  rtc:consumer "Smalt.ArmGateway.Router" ;
  rtc:sourcePack "ash-runtime-integration-contract-pack" ;
  rtc:moduleName "ArmEnvelope" ;
  rdfs:label "ARM envelope contract" .

<https://smalt.local/runtime-contracts/cosmos-header> a rtc:Contract ;
  rtc:id "cosmos_header" ;
  rtc:module "Smalt.RuntimeContracts.CosmosHeader" ;
  rtc:plane "data_plane" ;
  rtc:consumer "Smalt.EgressRouter (/dbs surface)" ;
  rtc:sourcePack "ash-runtime-integration-contract-pack" ;
  rtc:moduleName "CosmosHeader" ;
  rdfs:label "Cosmos header contract" .

<https://smalt.local/runtime-contracts/amqp-dialect> a rtc:Contract ;
  rtc:id "amqp_dialect" ;
  rtc:module "Smalt.RuntimeContracts.AmqpDialect" ;
  rtc:plane "messaging_plane" ;
  rtc:consumer "Smalt.Amqp.FrameCodec + Smalt.Amqp.DeliveryEncoder" ;
  rtc:sourcePack "ash-runtime-integration-contract-pack" ;
  rtc:moduleName "AmqpDialect" ;
  rdfs:label "AMQP 1.0 Service Bus dialect contract" .

<https://smalt.local/runtime-contracts/sentinel-ingest> a rtc:Contract ;
  rtc:id "sentinel_ingest" ;
  rtc:module "Smalt.RuntimeContracts.SentinelIngest" ;
  rtc:plane "data_plane" ;
  rtc:consumer "Smalt.EgressRouter (Sentinel surface)" ;
  rtc:sourcePack "ash-runtime-integration-contract-pack" ;
  rtc:moduleName "SentinelIngest" ;
  rdfs:label "Sentinel / Log Analytics ingest + KQL contract" .

<https://smalt.local/runtime-contracts/resource-graph-query> a rtc:Contract ;
  rtc:id "resource_graph_query" ;
  rtc:module "Smalt.RuntimeContracts.ResourceGraphQuery" ;
  rtc:plane "control_plane" ;
  rtc:consumer "Smalt.EgressRouter (Microsoft.ResourceGraph surface)" ;
  rtc:sourcePack "ash-runtime-integration-contract-pack" ;
  rtc:moduleName "ResourceGraphQuery" ;
  rdfs:label "Azure Resource Graph query contract" .

<https://smalt.local/runtime-contracts/purview-atlas> a rtc:Contract ;
  rtc:id "purview_atlas" ;
  rtc:module "Smalt.RuntimeContracts.PurviewAtlas" ;
  rtc:plane "data_plane" ;
  rtc:consumer "Smalt.EgressRouter (Atlas v2 surface)" ;
  rtc:sourcePack "ash-runtime-integration-contract-pack" ;
  rtc:moduleName "PurviewAtlas" ;
  rdfs:label "Purview Atlas v2 entity + lineage contract" .
