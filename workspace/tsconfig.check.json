{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "components/inspector/**/*.tsx",
    "lib/inspector/**/*.ts",
    "components/compliance/**/*.tsx",
    "lib/compliance/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
