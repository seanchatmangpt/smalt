# smalt — example environment
# Copy to `.env` and export, or just run `bash scripts/bootstrap.sh` /
# `eval "$(scripts/dev_env.sh)"` which derive all of these deterministically.
#
# All of these are OPTIONAL on a stock dev machine: dev_env.sh derives
# defaults, gen_dev_cert.sh mints TLS material, and the substrate reads
# them from the environment at boot.

# Vendored Azure SDK node_modules root (needed by the SDK-smoke and census
# tiers T3/T5; not needed for bootstrap or `just up`).
#   npm i @azure/cosmos @azure/event-hubs  (then point this at node_modules/)
SMALT_SDK_ROOT=/Users/sac/cai/athena/playground/node_modules

# Repo root (dir containing mix.exs). Normally derived from $PWD.
SMALT_REPO=/Users/sac/smalt

# Dev TLS leaf + key served by the ARM (9443) and Bandit egress (8443)
# listeners; minted by scripts/gen_dev_cert.sh (CA chain in .smalt/tls/).
SMALT_TLS_CERTFILE=/Users/sac/smalt/.smalt/tls/dev-cert.pem
SMALT_TLS_KEYFILE=/Users/sac/smalt/.smalt/tls/dev-key.pem

# Trust anchor for TLS clients (curl --cacert, Go/Apple chain verification).
# Exported by dev_env.sh alongside SMALT_TLS_*.
SSL_CERT_FILE=/Users/sac/smalt/.smalt/tls/ca-cert.pem

# Deterministic per-host Service Bus shared key (sha256(hostname+salt),
# base64). Derived by dev_env.sh; set explicitly only to match a peer.
# SMALT_SB_SHARED_KEY=<44-char base64 string>
