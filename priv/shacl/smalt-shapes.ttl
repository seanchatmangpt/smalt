# shapes/smalt-shapes.ttl
# SHACL shapes enforcing the hard-crash admission gate for every admitted
# resource type.
#
# Closed semantics: the evaluator (lib/smalt/graphlaw/validator.ex) enforces
# sh:closed true — an unknown payload property path yields a `closed`
# violation, merged with minCount/datatype results. NO shape below is closed:
# every shape declares sh:closed false EXPLICITLY because the declared
# property vocabulary is incomplete relative to real ARM payloads (tags, sku,
# dnsPrefix, addressSpace, template, ... all occur in conforming traffic).
# A shape may be flipped to sh:closed true only after its property list is
# complete against every payload that admitted traffic can carry.
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix smalt: <https://ggen.io/ontology/smalt#> .

smalt:DefaultShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:DefaultShapeClass ;
    # Azure parity (v26.10.19): child resources (queues, containers, subnets,
    # consumer groups, ...) inherit region from their parent — real ARM omits
    # `location` on child PUTs, so the default shape no longer requires it.
    # Top-level location is still type-constrained where a shape names it
    # (ResourceGroupShape, VNetShape).
    sh:property [
        sh:path smalt:location ;
        sh:maxCount 1 ;
        sh:message "A resource payload may carry at most one location." ;
    ] .

smalt:ResourceGroupShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:ResourceGroup ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "resourceGroups require exactly one location." ;
    ] .

smalt:VNetShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:VNet ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "virtualNetworks require location." ;
    ] , [
        sh:path smalt:addressPrefixes ;
        sh:minCount 1 ;
        sh:message "virtualNetworks require addressPrefixes." ;
    ] .

smalt:SubnetShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:Subnet ;
    sh:property [
        sh:path smalt:addressPrefix ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "subnets require addressPrefix." ;
    ] .

# KD-COVERS: KD-28 (2026-10-20, K5): NSG PUT shape tightened — location
# required, tags and properties.securityRules declared so sh:closed true
# refuses unknown top-level keys (witnessed: {"zzz":1} PUT -> 400) while
# conforming azurerm/SDK bodies pass. Boundary (documented, not fixable in
# this engine): securityRules ARRAY ITEMS are not descended by the evaluator;
# malformed rule objects inside the array are not reachable by minCount/closed.
smalt:NsgShape a sh:NodeShape ;
    sh:closed true ;
    sh:targetClass smalt:Nsg ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "networkSecurityGroups require location." ;
    ] , [
        sh:path smalt:tags ;
        sh:minCount 0 ;
        sh:message "NSG tags map." ;
    ] , [
        sh:path smalt:securityRules ;
        sh:minCount 0 ;
        sh:message "NSG properties.securityRules array (items not shape-descended)." ;
    ] ;
    sh:description "location required; closed to {location, tags, properties.securityRules}." .

smalt:VirtualMachineShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:VirtualMachine ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "virtualMachines require location." ;
    ] , [
        sh:path smalt:vmSize ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "virtualMachines require exactly one vmSize." ;
    ] .

smalt:KeyVaultShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:KeyVault ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "vaults require location." ;
    ] , [
        sh:path smalt:skuName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "vaults require skuName (standard|premium)." ;
    ] , [
        sh:path smalt:skuFamily ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:tenantId ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:enableSoftDelete ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:softDeleteRetentionInDays ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:enableRbacAuthorization ;
        sh:minCount 0 ;
    ] .

smalt:ManagedHsmShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:ManagedHsm ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "managedHSMs require location." ;
    ] , [
        sh:path smalt:skuName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "managedHSMs require skuName." ;
    ] .

smalt:StorageAccountShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:StorageAccount ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "storageAccounts require location." ;
    ] , [
        sh:path smalt:skuName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "storageAccounts require sku.name." ;
    ] , [
        sh:path smalt:kind ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:supportsHttpsTrafficOnly ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:allowBlobPublicAccess ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:minimumTlsVersion ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:networkAcls ;
        sh:minCount 0 ;
    ] .

smalt:ServiceBusNamespaceShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:ServiceBusNamespace ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "serviceBus namespaces require location." ;
    ] , [
        sh:path smalt:skuName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "serviceBus namespaces require skuName (Basic|Standard|Premium)." ;
    ] .

smalt:CosmosAccountShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:CosmosAccount ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "databaseAccounts require location." ;
    ] , [
        sh:path smalt:kind ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:databaseAccountOfferType ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:consistencyPolicy ;
        sh:minCount 0 ;
    ] , [
        sh:path smalt:enableMultipleWriteLocations ;
        sh:minCount 0 ;
    ] .

smalt:KeyVaultSecretShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:KeyVaultSecret ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "vaults/secrets require location." ;
    ] , [
        sh:path smalt:value ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "vaults/secrets require value." ;
    ] .

smalt:SqlDatabaseShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:SqlDatabase ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "sqlDatabases require location." ;
    ] .

smalt:SqlContainerShape a sh:NodeShape ;
    sh:closed false ;
    sh:targetClass smalt:SqlContainer ;
    sh:property [
        sh:path smalt:location ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "sqlContainers require location." ;
    ] .


#################################################################
# smalt:defaultValue annotations — single source of truth for the
# ARM PUT-body defaults table (Smalt.ArmGateway.Defaults @table).
# Each smalt:default row binds a dotted JSON path (smalt:jsonPath)
# to a declared shape path (smalt:shapePath). Bijection gate:
# verify/defaults-bijection.unbound.rq returns a row (FAIL) for any
# default whose shapePath is not declared in the shape's sh:property
# vocabulary — a default the shape refuses. DefaultKind: string |
# integer | boolean.
#################################################################
smalt:StorageAccountShape
    smalt:default
    [ smalt:jsonPath "location" ;
      smalt:value "[resourceGroup().location]" ;
      smalt:type "string" ;
      smalt:shapePath smalt:location ] ,
    [ smalt:jsonPath "sku.name" ;
      smalt:value "Standard_LRS" ;
      smalt:type "string" ;
      smalt:shapePath smalt:skuName ] ,
    [ smalt:jsonPath "kind" ;
      smalt:value "StorageV2" ;
      smalt:type "string" ;
      smalt:shapePath smalt:kind ] ,
    [ smalt:jsonPath "properties.supportsHttpsTrafficOnly" ;
      smalt:value "true" ;
      smalt:type "boolean" ;
      smalt:shapePath smalt:supportsHttpsTrafficOnly ] ,
    [ smalt:jsonPath "properties.allowBlobPublicAccess" ;
      smalt:value "true" ;
      smalt:type "boolean" ;
      smalt:shapePath smalt:allowBlobPublicAccess ] ,
    [ smalt:jsonPath "properties.minimumTlsVersion" ;
      smalt:value "TLS1_2" ;
      smalt:type "string" ;
      smalt:shapePath smalt:minimumTlsVersion ] ,
    [ smalt:jsonPath "properties.networkAcls.bypass" ;
      smalt:value "AzureServices" ;
      smalt:type "string" ;
      smalt:shapePath smalt:networkAcls ] ,
    [ smalt:jsonPath "properties.networkAcls.defaultAction" ;
      smalt:value "Allow" ;
      smalt:type "string" ;
      smalt:shapePath smalt:networkAcls ] .

smalt:KeyVaultShape
    smalt:default
    [ smalt:jsonPath "location" ;
      smalt:value "[resourceGroup().location]" ;
      smalt:type "string" ;
      smalt:shapePath smalt:location ] ,
    [ smalt:jsonPath "properties.sku.family" ;
      smalt:value "A" ;
      smalt:type "string" ;
      smalt:shapePath smalt:skuFamily ] ,
    [ smalt:jsonPath "properties.sku.name" ;
      smalt:value "standard" ;
      smalt:type "string" ;
      smalt:shapePath smalt:skuName ] ,
    [ smalt:jsonPath "properties.tenantId" ;
      smalt:value "[subscription().tenantId]" ;
      smalt:type "string" ;
      smalt:shapePath smalt:tenantId ] ,
    [ smalt:jsonPath "properties.enableSoftDelete" ;
      smalt:value "true" ;
      smalt:type "boolean" ;
      smalt:shapePath smalt:enableSoftDelete ] ,
    [ smalt:jsonPath "properties.softDeleteRetentionInDays" ;
      smalt:value "90" ;
      smalt:type "integer" ;
      smalt:shapePath smalt:softDeleteRetentionInDays ] ,
    [ smalt:jsonPath "properties.enableRbacAuthorization" ;
      smalt:value "true" ;
      smalt:type "boolean" ;
      smalt:shapePath smalt:enableRbacAuthorization ] .

smalt:CosmosAccountShape
    smalt:default
    [ smalt:jsonPath "location" ;
      smalt:value "[resourceGroup().location]" ;
      smalt:type "string" ;
      smalt:shapePath smalt:location ] ,
    [ smalt:jsonPath "kind" ;
      smalt:value "GlobalDocumentDB" ;
      smalt:type "string" ;
      smalt:shapePath smalt:kind ] ,
    [ smalt:jsonPath "properties.databaseAccountOfferType" ;
      smalt:value "Standard" ;
      smalt:type "string" ;
      smalt:shapePath smalt:databaseAccountOfferType ] ,
    [ smalt:jsonPath "properties.consistencyPolicy.defaultConsistencyLevel" ;
      smalt:value "Session" ;
      smalt:type "string" ;
      smalt:shapePath smalt:consistencyPolicy ] ,
    [ smalt:jsonPath "properties.enableMultipleWriteLocations" ;
      smalt:value "false" ;
      smalt:type "boolean" ;
      smalt:shapePath smalt:enableMultipleWriteLocations ] .
