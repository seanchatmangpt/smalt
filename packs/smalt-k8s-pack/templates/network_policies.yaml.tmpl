---
to: "k8s/{{ npName }}.gen.yaml"
force: true
for_each: np
sparql:
  np: |
    PREFIX k8s: <http://seanchatmangpt.github.io/packs/kubernetes#>
    SELECT ?fileName ?npName ?npDirection ?npPodSelectorBlock ?npRulesBlock
    WHERE {
      ?np a k8s:NetworkPolicy ; k8s:npName ?npName ;
          k8s:npDirection ?npDirection ;
          k8s:npPodSelectorBlock ?npPodSelectorBlock ;
          k8s:npRulesBlock ?npRulesBlock ;
          k8s:npForWorkload ?wl .
      ?wl k8s:fileName ?fileName .
    }
    ORDER BY ?fileName ?npName
---
{%- macro reindent(text, spaces) -%}
{%- for line in text | split(pat="\n") -%}
{{ spaces }}{{ line }}
{% endfor -%}
{%- endmacro reindent -%}
# GENERATED by ggen (smalt-k8s-pack/templates/network_policies.yaml.tmpl). Do not edit.
# Source of truth: priv/smalt-k8s.ttl (admitted k8s:NetworkPolicy facts). Regenerate: ggen sync run.
{%- for p in np %}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ p.npName }}
  namespace: default
spec:
  podSelector:
{{ self::reindent(text=p.npPodSelectorBlock, spaces="    ") }}
  policyTypes:
    - {{ p.npDirection }}
{%- if p.npRulesBlock | length > 0 %}
  {{ p.npDirection | lower }}:
{{ self::reindent(text=p.npRulesBlock, spaces="    ") }}
{%- endif %}
{%- endfor %}
