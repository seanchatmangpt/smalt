{%- for p in ports | filter(attribute="wl", value=wl) %}
            - name: {{ p.portName }}
              containerPort: {{ p.portNumber }}
{%- endfor %}
{%- endif %}
{%- if c.resourceRequestsBlock or c.resourceLimitsBlock %}
          resources:
{%- if c.resourceRequestsBlock %}
            requests:
{{ self::reindent(text=c.resourceRequestsBlock, spaces="              ") }}
{%- endif %}
{%- if c.resourceLimitsBlock %}
