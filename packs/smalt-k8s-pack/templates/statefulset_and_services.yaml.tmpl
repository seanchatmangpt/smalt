# Source of truth: priv/smalt-k8s.ttl (admitted k8s:StatefulSet/Container/EnvVar/
# ContainerPort/Service/ServicePort/Secret/ConfigMap facts). Regenerate: ggen sync run.
{%- for sec in secrets %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ sec.secretName }}
  namespace: {{ namespace | default(value="default") }}
type: Opaque
stringData:
{{ self::reindent(text=sec.secretStringDataBlock, spaces="  ") }}
{%- endfor %}
{%- for cm in configmaps %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ cm.configMapName }}
  namespace: {{ namespace | default(value="default") }}
