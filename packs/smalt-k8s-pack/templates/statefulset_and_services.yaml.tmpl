  serviceName: {{ serviceName }}
  replicas: {{ replicas | default(value=1) }}
  podManagementPolicy: {{ podManagementPolicy | default(value="OrderedReady") }}
  selector:
    matchLabels:
      app: {{ workloadName }}
  template:
    metadata:
