{{ self::reindent(text=cm.configMapDataBlock, spaces="  ") }}
{%- endfor %}
{%- for s in services | filter(attribute="wl", value=wl) %}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ s.serviceName }}
  namespace: {{ namespace | default(value="default") }}
{%- if s.serviceType == "ClusterIP" and s.serviceClusterIP | default(value="") == "None" %}
  labels:
    app: {{ workloadName }}
{%- endif %}
spec:
{%- if s.serviceClusterIP | default(value="") %}
  clusterIP: {{ s.serviceClusterIP }}
{%- endif %}
  selector:
    app: {{ workloadName }}
  ports:
{%- for sp in servicePorts %}
{%- if sp.svcServiceName == s.serviceName %}
    - name: {{ sp.svcPortName }}
      port: {{ sp.svcPortNumber }}
      targetPort: {{ sp.svcTargetPortName }}
{%- if sp.svcNodePort | default(value=0) %}
      nodePort: {{ sp.svcNodePort }}
{%- endif %}
{%- endif %}
{%- endfor %}
  type: {{ s.serviceType }}
{%- endfor %}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ workloadName }}
  namespace: {{ namespace | default(value="default") }}
  labels:
