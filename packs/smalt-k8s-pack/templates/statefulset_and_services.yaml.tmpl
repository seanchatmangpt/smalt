{%- if c.image %}
          image: {{ c.image }}
{%- endif %}
{%- if c.imagePullPolicy %}
          imagePullPolicy: {{ c.imagePullPolicy }}
{%- endif %}
{%- if c.containerSecurityContextBlock %}
          securityContext:
{{ self::reindent(text=c.containerSecurityContextBlock, spaces="            ") }}
{%- endif %}
{%- if ports | filter(attribute="wl", value=wl) %}
