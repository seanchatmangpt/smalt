{{ self::reindent(text=podSecurityContextBlock, spaces="        ") }}
{%- endif %}
      terminationGracePeriodSeconds: {{ terminationGracePeriodSeconds | default(value=30) }}
      containers:
{%- for c in containers | filter(attribute="wl", value=wl) %}
