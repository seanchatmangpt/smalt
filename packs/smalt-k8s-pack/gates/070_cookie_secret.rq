# MESSAGE: smalt-k8s-pack release-cookie gate (NIST work item W2, IA-5(1)
# MESSAGE: credential management, lane BK-NISTW2). The BEAM distribution
# MESSAGE: cookie is a credential, not configuration: every workload env var
# MESSAGE: named RELEASE_COOKIE must be sourced from a Secret
# MESSAGE: (envSecretName + envSecretKey) -- a ConfigMap-sourced or
# MESSAGE: literal-value cookie is a refused subject. And an admitted cookie
# MESSAGE: Secret must not carry a placeholder value ("replace-me"):
# MESSAGE: `cookie: replace-me-before-apply` applied to a cluster is a
# MESSAGE: well-known-credential cluster. Any row = a refused subject.
PREFIX k8s: <http://seanchatmangpt.github.io/packs/kubernetes#>
SELECT ?s ?violation WHERE {
  {
    ?s a k8s:EnvVar ; k8s:envName "RELEASE_COOKIE" .
    FILTER NOT EXISTS {
      ?s k8s:envSecretName ?sn . ?s k8s:envSecretKey ?sk .
    }
    BIND("COOKIE_ENV_NOT_SECRET_REF" AS ?violation)
  } UNION {
    ?s a k8s:Secret ; k8s:secretStringDataBlock ?block .
    FILTER(REGEX(STR(?block), "replace-me", "i"))
    BIND("COOKIE_SECRET_PLACEHOLDER_VALUE" AS ?violation)
  }
}
ORDER BY ?s ?violation
