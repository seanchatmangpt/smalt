---
# go_membrane_op.go.tmpl — ggen template (lane P3, v26.10.30).
#
# Renders the Go membrane-op struct + dispatcher per admitted
# posh:IngressRoute (solution rows from queries/construct_go_adapter.rq,
# materialized into the graph by the [inference] CONSTRUCT rules in
# ggen.toml) into posh/internal/api/generated_adapters.go — one entry
# per membrane op, egress allowlist entries projected from sink
# deliverTo hosts, the turnstile receipt fail-closed (missing token =
# REFUSED_EGRESS). Calls ONLY the landed posh/internal ABI:
# egress.NormalizeHost / AdmitsHost / NewFencedClient and
# DecodeRequest / NewOK / NewRefusedEgress / NewTransport / Encode /
# NewErrorResponse. No phantom C ABI. The allowlist cannot drift from
# the graph: both are projections. Regeneration must be byte-identical.
to: "generated/posh/internal/adapter/generated_adapters.go"
force: true
for_each: adapter
sparql:
  adapter: |
    PREFIX posh: <https://smalt.dev/posh/ns#>
    SELECT ?route ?op ?method ?allowHost ?receipt
    WHERE {
      ?route a posh:IngressRoute ;
        posh:admittedBy ?turnstile ;
        posh:membraneOp ?op .
      ?turnstile posh:emits ?receipt .
      ?route posh:sink ?sink .
      ?sink posh:deliverTo ?allowHost .
      BIND(REPLACE(?op, "[.-]", "_") AS ?method)
    }
    ORDER BY ?method
---

// Code generated by ggen from packs/posh/ontology/posh.ttl — DO NOT EDIT.
// Membrane ops + egress allowlist, projected from the POSH graph.
package adapter

import (
	"bytes"
	"net/http"
	"time"

	"smalt.dev/posh/internal/api"
	"smalt.dev/posh/internal/config"
	"smalt.dev/posh/internal/egress"
)

// MembraneOp is a BEAM<->Go peripheral-membrane operation crossing the
// membrane. One struct per admitted posh:membraneOp.
type MembraneOp struct {
	Op       string // membrane op name, e.g. "{{ op }}"
	Method   string // Go dispatch method name (dots/dashes -> underscores)
	TurnstileReceipt   string // receipt emitted by the admitting turnstile
	AllowHosts []string // egress allowlist hosts (graph-projected)
}

// Membrane handlers, one per op. The allowlist entries below are the
// graph's posh:deliverTo hosts — fail-closed dispatch (POSH-008).
var generatedOps = map[string]*MembraneOp{
{% for a in adapter %}
	"{{ a.op }}": {
		Op:     "{{ a.op }}",
		Method: "{{ a.method }}",
		TurnstileReceipt: "{{ a.receipt }}",
		AllowHosts: []string{"{{ a.allowHost }}"},
	},
{% endfor %}
}

// Dispatch routes an op through its membrane handler. An op absent from
// the projected table is refused — no dynamic allowlist, no bypass.
func Dispatch(cfg *config.Config, op string, payload []byte) ([]byte, error) {
	mop, ok := generatedOps[op]
	if !ok {
		return nil, api.NewRefusedEgress(op, nil, "op %q not admitted by the graph", op)
	}
	return mop.deliver(cfg, payload)
}

// deliver sends one admitted frame across the membrane through the
// egress fence. Receipt rule (POS-008, fail-closed): the turnstile
// token projected from the graph is mandatory before any frame leaves
// Starboard Out; a host not admitted by cfg's fence is refused.
func (m *MembraneOp) deliver(cfg *config.Config, payload []byte) ([]byte, error) {
	if m.TurnstileReceipt == "" {
		return nil, api.NewRefusedEgress(m.Op, nil, "missing turnstile receipt for op %q", m.Op)
	}
	if len(m.AllowHosts) == 0 {
		return nil, api.NewRefusedEgress(m.Op, nil, "no declared sink for op %q", m.Op)
	}
	if !egress.AdmitsHost(cfg, m.AllowHosts[0]) {
		return nil, api.NewRefusedEgress(m.Op, nil, "host %q refused by the egress fence", m.AllowHosts[0])
	}
	req, err := api.DecodeRequest(payload)
	if err != nil {
		return nil, api.NewTransport(m.Op, err, "decode membrane request")
	}
	client := egress.NewFencedClient(cfg, 10*time.Second)
	httpReq, err := http.NewRequest(http.MethodPost, m.AllowHosts[0], bytes.NewReader(payload))
	if err != nil {
		return nil, api.NewTransport(m.Op, err, "build egress request for %q", m.AllowHosts[0])
	}
	httpReq.Header.Set("Content-Type", "application/json")
	resp, err := client.Do(httpReq)
	if err != nil {
		return nil, api.NewTransport(m.Op, err, "egress to %q", m.AllowHosts[0])
	}
	defer resp.Body.Close()
	if resp.StatusCode != http.StatusOK {
		return api.Encode(api.NewErrorResponse(req.ID, api.NewUpstream(m.Op, nil, "sink %q status %d", m.AllowHosts[0], resp.StatusCode)))
	}
	return api.Encode(api.NewOK(req.ID, map[string]string{"delivered": m.AllowHosts[0]}))
}
