---
# go_membrane_op.go.tmpl - ggen template (lane P3/F12, v26.10.30).
#
# Renders the Go membrane adapter, projected from the pack graph:
#   * generated/posh/internal/adapter/generated_ops_<method>.go - one
#     init() registration per admitted posh:membraneOp (per-row fan-out)
#   * generated/posh/internal/adapter/generated_dispatcher.go - the
#     Dispatch/deliver machinery, rendered from a singleton row
# One entry per membrane op; egress allowlist entries are projected
# from sink deliverTo hosts; the turnstile receipt is fail-closed
# (missing token = REFUSED_EGRESS). Calls ONLY the landed
# posh/internal ABI: egress.NormalizeHost/AdmitsHost/NewFencedClient
# and api.DecodeRequest/NewOK/NewRefusedEgress/NewTransport/Encode/
# NewErrorResponse/NewUpstream. No phantom C ABI. The allowlist cannot
# drift from the graph: both are projections. Regeneration must be
# byte-identical.
to: "generated/posh/internal/adapter/generated_ops_{{ method }}.go"
force: true
for_each: adapter
sparql:
  adapter: |
    PREFIX posh: <https://smalt.dev/posh/ns#>
    SELECT ?route ?op ?method ?allowHost ?receipt
    WHERE {
      ?route a posh:IngressRoute ;
        posh:admittedBy ?turnstile ;
        posh:membraneOp ?op .
      ?turnstile posh:emits ?receipt .
      ?route posh:sink ?sink .
      ?sink posh:deliverTo ?allowHost .
      BIND(REPLACE(?op, "[.-]", "_") AS ?method)
    }
    ORDER BY ?method
---
// Code generated by ggen from packs/posh/ontology/posh.ttl — DO NOT EDIT.
// Per-op membrane registration: package-level generatedOps map entries.
package adapter

import "smalt.dev/posh/internal/dialect"

func init() {
	generatedOps["{{ op }}"] = &MembraneOp{
		Op:     "{{ op }}",
		Method: "{{ method }}",
		TurnstileReceipt: "{{ receipt }}",
		AllowHosts: []string{"{{ allowHost }}"},
	}
	dialectSpecs["{{ op }}"] = dialect.OpSpec{
		Op: "{{ op }}",
		TurnstileReceipt: "{{ receipt }}",
		AllowHosts: []string{"{{ allowHost }}"},
	}
}
