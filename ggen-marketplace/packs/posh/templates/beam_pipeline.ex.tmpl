---
# beam_pipeline.ex.tmpl - ggen template (lane L3/F12, v26.10.30).
#
# Renders one Elixir pipeline module per admitted posh:IngressRoute
# (solution rows from the front-matter SELECT; keep in lockstep with
# queries/construct_beam_pipeline.rq) to
# generated/lib/smalt/posh/pipeline/<op>.ex (the posh-generate recipe
# copies it to repo-root lib/smalt/posh/pipeline/). Plain module, no
# GenStage: smalt carries no gen_stage dep; the hand-written runtime
# (lib/smalt/posh) owns the event loop. THIS TEMPLATE IS THE PRODUCT:
# never hand-edit rendered output; regeneration must be byte-identical.
to: "generated/lib/smalt/posh/pipeline/{{ op }}.ex"
force: true
for_each: pipeline
sparql:
  pipeline: |
    PREFIX posh: <https://smalt.dev/posh/ns#>
    SELECT ?route ?op ?module ?shape ?turnstile ?turnstileMod ?receipt ?sinkHost
    WHERE {
      ?route a posh:IngressRoute ;
        posh:admittedBy ?turnstile ;
        posh:shape      ?shape ;
        posh:membraneOp ?op .
      ?turnstile posh:emits ?receipt .
      OPTIONAL { ?route posh:sink ?sink2 . ?sink2 posh:deliverTo ?sinkHost . }
      # G26 option (a): the runtime turnstile is ONE module
      # (lib/smalt/posh/turnstile.ex); per-route module namespaces were
      # ghosts the runtime never defined. Bind the literal.
      BIND("Smalt.Posh.Turnstile" AS ?turnstileMod)
      BIND(CONCAT("Smalt.Posh.Pipeline.", UCASE(SUBSTR(REPLACE(?op, "[.-]", "_"), 1, 1)), SUBSTR(REPLACE(?op, "[.-]", "_"), 2)) AS ?module)
    }
    ORDER BY ?module
---
# Generated by ggen from packs/posh/ontology/posh.ttl — DO NOT EDIT.
# Route: {{ route }} | turnstile: {{ turnstile }} | shape: {{ shape }}
defmodule {{ module }} do
  @moduledoc """
  POSH Port In pipeline for membrane op `{{ op }}`.

  Projected from the admitted topology: frames validate against shape
  `{{ shape }}`, admit through turnstile `{{ turnstile }}` (receipt
  `{{ receipt }}`), then deliver{% if sinkHost %} to `{{ sinkHost }}{% endif %}.

  A frame that fails shape validation or is refused by the turnstile yields
  a typed `{:refused, reason}` — never silently dropped (Andon RED at the
  gateway seam). NOTE: this is a plain
  pipeline module, not a GenStage — smalt carries no gen_stage dep; the
  orchestration layer (lib/smalt/posh/supervisor.ex) owns the event loop.
  """

  @doc """
  Admission: validate the frame against the route's SHACL shape, then pass
  through the REAL runtime fence `Smalt.Posh.Turnstile.admit/5` (G26 option
  (a); arity + settlement shape verified against the hand-written module).

  Requires `state[:policy]` — a compiled `Smalt.Posh.Ingress.Admission`
  policy; the pack projects topology, policy compilation stays in the
  hand-written runtime. Optional `state` keys: `:route`, `:state_root`,
  `:log_name` (defaults: `{{ op }}`, `"smalt"`, `Smalt.Posh.Egress.EventLog`).

  Returns:
    {:ok, settlement}  — settlement map, 32-byte `:receipt`, event log has the entry
    {:refused, reason} — typed refusal (:no_admission_policy,
      {:shape_violation, _}, {:admission_crash, _}); never raises, the
      caller halts fail-closed (Andon RED at the gateway seam)
  """
  def admit(frame, state \\ %{}) do
    policy = Map.get(state, :policy)

    unless policy do
      raise ArgumentError,
            "admit/2 requires state[:policy] (compiled Smalt.Posh.Ingress.Admission)"
    end

    route = Map.get(state, :route, "{{ op }}")
    state_root = Map.get(state, :state_root, "smalt")
    log_name = Map.get(state, :log_name, Smalt.Posh.Egress.EventLog)

    opts = [
      op: "{{ op }}",
      payload_body: frame_body(frame),
      log_name: log_name
    ]

    with :ok <- validate(frame, shape_iri()),
         {:ok, %{receipt: _receipt} = settlement} <-
           turnstile().admit(policy, route, frame, state_root, opts) do
      {:ok, settlement}
    else
      {:refused, reason} -> {:refused, reason}
      {:ok, other} -> {:refused, {:unexpected_turnstile_result, other}}
    end
  end

  @doc "Turnstile module this pipeline admits through (graph-projected)."
  def turnstile_module, do: "{{ turnstileMod }}"

  @doc "Shape IRI frames are validated against (graph-projected)."
  def shape_iri, do: "{{ shape }}"

  @doc "Receipt IRI this route's turnstile emits (graph-projected)."
  def receipt_iri, do: "{{ receipt }}"

  defp turnstile, do: Smalt.Posh.Turnstile

  defp frame_body(frame) when is_binary(frame), do: frame
  defp frame_body(frame), do: Jason.encode!(frame)

  @doc """
  Port In shape validation — the REAL thin runtime SHACL-subset gate
  (G32 Option C, lane 44): the shape IRI projected from the graph resolves
  to the pack's compiled ingress shapes; validation behavior lives in the
  hand-written runtime (`Smalt.Posh.Ingress.ShapeValidator`) — the pack
  projects topology, behavior is never synthesized. Fail-closed: an unknown
  shape IRI still validates against the closed IngressRoute shapes.
  """
  def validate(frame, shape_iri) do
    Smalt.Posh.Ingress.ShapeValidator.validate(shape_iri, frame)
  end

  defoverridable [validate: 2]
end
