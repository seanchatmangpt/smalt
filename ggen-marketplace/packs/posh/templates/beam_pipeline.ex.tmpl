# beam_pipeline.ex.tmpl - ggen template (lane L3/F12, v26.10.30).
#
# Renders one Elixir pipeline module per admitted posh:IngressRoute
# (solution rows from the front-matter SELECT - keep in lockstep with
# queries/construct_beam_pipeline.rq) to generated/lib/smalt/posh/pipeline/<op>.ex.
# Plain module, no GenStage: smalt carries no gen_stage dep; the
# hand-written runtime (lib/smalt/posh) owns the event loop.
to: "generated/lib/smalt/posh/pipeline/{{ op }}.ex"
force: true
for_each: pipeline
sparql:
  pipeline: |
    PREFIX posh: <https://smalt.dev/posh/ns#>
    SELECT ?route ?op ?module ?shape ?turnstile ?turnstileMod ?receipt ?sinkHost
    WHERE {
      ?route a posh:IngressRoute ;
        posh:admittedBy ?turnstile ;
        posh:shape      ?shape ;
        posh:membraneOp ?op .
      ?turnstile posh:emits ?receipt .
      OPTIONAL { ?route posh:sink ?sink2 . ?sink2 posh:deliverTo ?sinkHost . }
      BIND(CONCAT("Smalt.Posh.Turnstile.", UCASE(SUBSTR(REPLACE(STR(?turnstile), "^.*[#/]", ""), 1, 1)), SUBSTR(REPLACE(STR(?turnstile), "^.*[#/]", ""), 2)) AS ?turnstileMod)
      BIND(CONCAT("Smalt.Posh.Pipeline.", UCASE(SUBSTR(REPLACE(?op, "[.-]", "_"), 1, 1)), SUBSTR(REPLACE(?op, "[.-]", "_"), 2)) as ?module)
    }
    ORDER BY ?module
---
# gen
defmodule {{ module }} do
  def op, do: "{{ op }}"
end
