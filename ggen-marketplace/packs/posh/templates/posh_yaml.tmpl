---
# posh_yaml.tmpl - ggen template (GAP-29 lane 42, v26.10.30).
#
# Projects posh:Sink posh:deliverTo into the egress allowlist FRAGMENT
# generated/posh/config/egress_allowlist.generated.yaml. Normalization
# mirrors internal/egress.NormalizeHost exactly (strip scheme, strip
# port+path, lowercase) so every rendered entry is a bare hostname that
# internal/config validate() accepts (rejects / : @ space). The runtime
# authority stays posh/posh.yaml (config.go/egress.go untouched); the
# graph is the CEILING: operator posh.yaml may narrow, never widen —
# scripts/posh_merge_allowlist.sh enforces the subset law at integration
# (just posh-regen-check). FM-WRITE-002 forbids .. traversal, so this
# renders a fragment in the pack tree, never posh.yaml directly.
to: "generated/posh/config/egress_allowlist.generated.yaml"
force: true
for_each: egress  # single aggregate row: GROUP_CONCAT -> one render, never per-row concatenation
sparql:
  egress: |
    PREFIX posh: <https://smalt.dev/posh/ns#>
    # GAP-29 egress_allowlist projection: graph -> bare hostname.
    # Normalization mirrors egress.NormalizeHost: strip scheme, strip
    # port+path, lowercase. GROUP_CONCAT(DISTINCT) makes the port-collapse
    # (127.0.0.1:7443 and :9443 -> one 127.0.0.1 row) deterministic; the
    # template sorts the CSV so the render is order-stable.
    SELECT (GROUP_CONCAT(DISTINCT ?egressHost; separator=",") AS ?hosts) WHERE {
      ?sink a posh:Sink ;
            posh:deliverTo ?raw .
      BIND(LCASE(REPLACE(
             REPLACE(?raw, "^[a-z][a-z0-9+.-]*://", ""),
             ":[0-9]+(/.*)?$", "")) AS ?egressHost)
    }
---
# Code generated by ggen from packs/posh/ontology/posh.ttl — DO NOT EDIT.
# Egress allowlist fragment: posh:Sink posh:deliverTo normalized to the
# bare hostname shape config.go validate() accepts. Graph is the ceiling;
# the operator posh.yaml may narrow, never widen.
{%- set hosts_sorted = hosts | split(pat=",") | sort -%}
{%- for h in hosts_sorted %}
- {{ h }}
{%- endfor %}
